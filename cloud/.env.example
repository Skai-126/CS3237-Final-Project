# Copy this file to .env (gitignored) and fill in your real password.
# If the password has special characters like @ or #, URL-encode them.

# Local server, app account (read/write)
DB_URL=mysql+pymysql://zonesort:pick-a-password@127.0.0.1:3306/zonesort

# Teammate connecting over Tailscale, read-only account
# DB_URL=mysql+pymysql://viewer:another-password@100.x.x.x:3306/zonesort

# MQTT broker. Team broker (TLS): its IP from Daniel, port 8883, our login, and the
# broker's certificate (path relative to this folder). Local Mosquitto instead:
# MQTT_HOST=127.0.0.1, MQTT_PORT=1883, and leave the last three lines out.
MQTT_HOST=<team-broker-ip>
MQTT_PORT=8883
MQTT_USERNAME=database
MQTT_PASSWORD=ask-the-team
MQTT_CA_CERT=server.crt
