# Copy to .env and edit locally. Never commit real credentials.
# MQTT broker. Team broker (TLS): its IP from Daniel, port 8883, our login, and the
# broker's certificate (path relative to this folder). Local Mosquitto instead:
# MQTT_HOST=127.0.0.1, MQTT_PORT=1883, and leave the last three lines out.
MQTT_HOST=<team-broker-ip>
MQTT_PORT=8883
MQTT_USERNAME=scanner
MQTT_PASSWORD=ask-the-team
MQTT_CA_CERT=../cloud/server.crt
